# =============================================================================
# Mankind Matrix — single .env for mankind_services (copy to .env at repo root)
# =============================================================================

# Application
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ROOT=info

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mankind_matrix_db
DB_USERNAME=matrix_user
DB_PASSWORD=matrix_pass
DB_CONNECT_TIMEOUT=30000
DB_SOCKET_TIMEOUT=30000
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DB_SERVER_TIMEZONE=UTC
DB_AUTO_RECONNECT=true
DB_FAIL_OVER_READ_ONLY=false
DB_HIKARI_MAX_POOL_SIZE=10
DB_HIKARI_MIN_IDLE=2
DB_HIKARI_CONNECTION_TIMEOUT=20000
DB_HIKARI_IDLE_TIMEOUT=120000
DB_HIKARI_MAX_LIFETIME=300000
DB_HIKARI_LEAK_DETECTION_THRESHOLD=30000

# Keycloak (browser / JWT issuer — use host port 8180 locally)
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ISSUER_URL=http://localhost:8180
# Admin & token API (Docker Compose sets KEYCLOAK_ADMIN_URL=http://keycloak:8080)
KEYCLOAK_ADMIN_URL=http://localhost:8180
# JWKS URL (Docker Compose sets KEYCLOAK_JWK_SET_URI=http://keycloak:8080/.../certs)
KEYCLOAK_JWK_SET_URI=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Leave empty for public Keycloak client "user-service" (password grant)
KEYCLOAK_CLIENT_SECRET=

# Internal Feign loopback (same JVM — do not change unless SERVER_PORT changes)
USER_SERVICE_URL=http://127.0.0.1:8085
PRODUCT_SERVICE_URL=http://127.0.0.1:8085
CART_SERVICE_URL=http://127.0.0.1:8085
COUPON_SERVICE_URL=http://127.0.0.1:8085
PAYMENT_SERVICE_URL=http://127.0.0.1:8085

# Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# Email (notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS (optional — Twilio)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_PHONE_NUMBER=
